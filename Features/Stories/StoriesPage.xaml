<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GBV_Shield.Features.Stories.StoriesPage"
             Title="Stories">

    <VerticalStackLayout Padding="10" Spacing="10">

        <Button Text="➕ Share Your Story"
                Clicked="OnAddStoryClicked"
                BackgroundColor="#2196F3"
                TextColor="White" />

        <CollectionView x:Name="StoriesCollection">
            <!-- Use explicit layout to avoid ItemsLayout enum parsing issues -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5"
                           BorderColor="LightGray"
                           CornerRadius="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Author}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Text="{Binding Content}"
                                   FontSize="14"
                                   TextColor="Black" />
                            <!-- Escape StringFormat braces with {} -->
                            <Label Text="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
